# Twitch Developer Console uygulamanin bilgileri
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kanalin Twitch kullanici adi (URL'deki / sonrasi, @ olmadan)
TWITCH_CHANNEL=

# Yerel sunucu ayarlari (sunucu her zaman yalnizca 127.0.0.1'de dinler)
PORT=3131

# Kazan: her gecerli !throw yuzdeyi kac artirsin (10 = 10 atista dolar)
FILL_PER_THROW=10
# Completed cauldron outcome type odds
REWARD_CHANCE=50
# Golden throw: 5% chance of triple fill
GOLDEN_THROW_CHANCE=5
GOLDEN_THROW_MULTIPLIER=3
# Cauldron loses 0.5 percentage points per idle minute (1% every 2 minutes); 0 disables cooling
CAULDRON_COOLING_PER_MINUTE=0.5

# Bekleme sureleri (saniye)
# Ayni kisinin iki !throw arasi bekleme
THROW_COOLDOWN_SECONDS=180
# Herhangi iki !throw arasi ortak bekleme
GLOBAL_COOLDOWN_SECONDS=5
# Botun "su kadar bekle" mesajini chat'e yazmasi (true / false)
COOLDOWN_NOTICES=true

# Ceza oylamasinin suresi (saniye, 5-300)
VOTE_SECONDS=30

# Optional channel emotes allowed with !throw. Leave NAME blank to disable a slot.
# Use the actual emote in Twitch chat: !throw EmoteName (Twitch resolves it to an emote tag).
# Slots 1-2 are normal; slots 3-4 are animated. KIND selects how the emote image is displayed.
# Each valid use adds FILL percentage points (then golden multiplier can apply).
# Each valid use also adds PUNISHMENT_BONUS percentage points to this round's punishment chance.
THROW_EMOTE_1_NAME=
THROW_EMOTE_1_KIND=normal
THROW_EMOTE_1_FILL=15
THROW_EMOTE_1_PUNISHMENT_BONUS=2
THROW_EMOTE_2_NAME=
THROW_EMOTE_2_KIND=normal
THROW_EMOTE_2_FILL=15
THROW_EMOTE_2_PUNISHMENT_BONUS=2
THROW_EMOTE_3_NAME=
THROW_EMOTE_3_KIND=animated
THROW_EMOTE_3_FILL=15
THROW_EMOTE_3_PUNISHMENT_BONUS=2
THROW_EMOTE_4_NAME=
THROW_EMOTE_4_KIND=animated
THROW_EMOTE_4_FILL=15
THROW_EMOTE_4_PUNISHMENT_BONUS=2
