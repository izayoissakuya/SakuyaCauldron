# Twitch Developer Console uygulamanin bilgileri
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kanalin Twitch kullanici adi (URL'deki / sonrasi, @ olmadan)
TWITCH_CHANNEL=

# Yerel sunucu ayarlari (sunucu her zaman yalnizca 127.0.0.1'de dinler)
PORT=3131

# Kazan: her gecerli !throw yuzdeyi kac artirsin (10 = 10 atista dolar)
FILL_PER_THROW=10
# Completed cauldron outcome type odds
REWARD_CHANCE=50
# Golden throw: 5% chance of triple fill
GOLDEN_THROW_CHANCE=5
GOLDEN_THROW_MULTIPLIER=3
# Cauldron loses 1% per minute when idle (0 disables cooling)
CAULDRON_COOLING_PER_MINUTE=1

# Bekleme sureleri (saniye)
# Ayni kisinin iki !throw arasi bekleme
THROW_COOLDOWN_SECONDS=180
# Herhangi iki !throw arasi ortak bekleme
GLOBAL_COOLDOWN_SECONDS=5
# Botun "su kadar bekle" mesajini chat'e yazmasi (true / false)
COOLDOWN_NOTICES=true

# Ceza oylamasinin suresi (saniye, 5-300)
VOTE_SECONDS=30

# Ekrana dusmesini istemedigin ek emojiler, yan yana yaz (ornek: BLOCKED_EMOJIS=🔫🍺)
# Varsayilan engelli liste server.js icindeki DEFAULT_BLOCKED_EMOJIS'tir.
BLOCKED_EMOJIS=
